    <Reference Include="Heathen.Steamworks"><HintPath>$(GameDirectory)\Sephiria_Data\Managed\Heathen.Steamworks.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="com.rlabrecque.steamworks.net"><HintPath>$(GameDirectory)\Sephiria_Data\Managed\com.rlabrecque.steamworks.net.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(GameDirectory)\Sephiria_Data\Managed\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
