    <Compile Include="*.cs" />
    <Reference Include="Assembly-CSharp"><HintPath>$(GameDirectory)\Sephiria_Data\Managed\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mirror"><HintPath>$(GameDirectory)\Sephiria_Data\Managed\Mirror.dll</HintPath><Private>false</Private></Reference>
