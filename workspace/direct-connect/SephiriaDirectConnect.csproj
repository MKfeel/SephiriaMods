    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(GameDirectory)\Sephiria_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(GameDirectory)\Sephiria_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="$(GameDirectory)\BepInEx\core\BepInEx.dll"><Private>false</Private></Reference>
